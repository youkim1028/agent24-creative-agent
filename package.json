{
  "name": "deckforge-x",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Six-agent GPT pipeline that turns live X, YouTube, and Hacker News signals into validated PPTX decks.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "qa:render": "npm run build && node scripts/render-qa-sample.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "dotenv": "latest",
    "express": "latest",
    "openai": "latest",
    "pptxgenjs": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
