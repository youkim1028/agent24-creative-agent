{
  "name": "agent24-creative-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hackathon-ready creative agent with inspectable tool-call traces.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "dotenv": "latest",
    "express": "latest",
    "openai": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}

