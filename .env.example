# Never commit a real key. Copy this file to .env locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Team model routing: fast for research, quality for synthesis, critic for review.
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_QUALITY_MODEL=gpt-5.6-terra
OPENAI_CRITIC_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=5000
AGENT_MAX_TOTAL_TOKENS=20000
AGENT_ARCHITECTURE=team
XAI_API_KEY=
GROK_MODEL=grok-4.5
GROK_MAX_OUTPUT_TOKENS=900
X_MAX_POSTS=6
REDDIT_ENABLED=true
REDDIT_USER_AGENT=DeckForgeX/0.1 community-research
REDDIT_MAX_POSTS=6
REDDIT_TIMEOUT_MS=8000
GCS_MEMORY_ENABLED=false
GCS_BUCKET=
GCS_PREFIX=deckforge-x/research
GCS_PROJECT_ID=
GCS_CACHE_TTL_HOURS=24
PORT=3000
MOCK_OPENAI=false
MOCK_XAI=false

